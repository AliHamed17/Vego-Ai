{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vego-ai/schemas/human_review_item.schema.json",
  "title": "VEGO-AI Human Review Item",
  "description": "One human-review item emitted by the Selective Intervention Policy when Agent 4 (Variability Explorer) produces a variability classification that warrants human judgment. Each item corresponds to one recurring variability PATTERN (P1, P2, ...), not to a single case model.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_id",
    "review_signature",
    "schema_version",
    "provenance",
    "setting_id",
    "pattern_id",
    "pipeline_stage",
    "ai_decision",
    "trigger_reasons",
    "status"
  ],
  "properties": {
    "review_id": {
      "type": "string",
      "description": "Human-readable identifier: HRQ-<setting_id>-<pattern_id>. Note: depends on Agent 4 pattern ordering; use review_signature for stable joins.",
      "pattern": "^HRQ-.+-P[0-9]+$"
    },
    "review_signature": {
      "type": "string",
      "description": "Order-independent sha256 prefix over signature_fields; detects whether review_id drifted to a different pattern.",
      "pattern": "^[0-9a-f]{16}$"
    },
    "signature_fields": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Logical field names hashed into review_signature."
    },
    "source_pattern_id": {
      "type": "string",
      "description": "The Agent 4 pattern_id this item was built from.",
      "pattern": "^P[0-9]+$"
    },
    "schema_version": { "type": "string" },
    "created_at": {
      "type": "string",
      "description": "ISO-8601 UTC timestamp when the item was generated."
    },
    "provenance": {
      "type": "object",
      "description": "Where/how this item was produced — for cross-experiment comparison.",
      "additionalProperties": true,
      "required": ["source_system", "policy_version", "source_setting"],
      "properties": {
        "source_system": { "type": "string" },
        "policy_version": { "type": "string" },
        "source_commit": { "type": "string" },
        "source_setting": { "type": "string" },
        "policy_config": {
          "type": "object",
          "properties": { "include_medium": { "type": "boolean" } }
        }
      }
    },
    "setting_id": {
      "type": "string",
      "enum": ["ucd_ch", "cd_ch", "ucd_pw", "cd_pw"]
    },
    "domain": { "type": "string", "description": "e.g. cheers | parkwise" },
    "diagram_type": { "type": "string", "description": "UCD | CD" },
    "pipeline_stage": {
      "type": "string",
      "enum": ["agent4_classify_variability"]
    },
    "pattern_id": { "type": "string", "pattern": "^P[0-9]+$" },
    "pattern_kind": {
      "type": "string",
      "enum": ["guideline", "fragment", "unknown"]
    },
    "target_fragment": {
      "type": "string",
      "description": "Description of the pattern (joined from deviation_patterns)."
    },
    "related_guideline_id": {
      "type": ["string", "null"],
      "description": "Guideline the pattern concerns (Gj), if resolved."
    },
    "related_guideline_resolution": {
      "type": "object",
      "description": "How related_guideline_id was determined (transparency).",
      "additionalProperties": false,
      "required": ["method", "candidate_guidelines"],
      "properties": {
        "method": {
          "type": "string",
          "enum": ["from_pattern", "parsed_from_evidence", "none"]
        },
        "confidence": { "type": ["string", "null"], "enum": ["high", "medium", "low", null] },
        "candidate_guidelines": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "affected_cases": {
      "type": "array",
      "items": { "type": "string" }
    },
    "pattern_strength": {
      "type": "object",
      "description": "Recurrence strength, both numeric and display form.",
      "additionalProperties": false,
      "properties": {
        "value": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "display": { "type": ["string", "null"] }
      }
    },
    "ai_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "confidence", "flag_for_guidelines_update", "requires_human_review"],
      "properties": {
        "classification": {
          "type": "string",
          "enum": ["Substantial Variability", "Occasional Variability", "Undetermined"]
        },
        "confidence": { "type": "string", "enum": ["High", "Medium", "Low"] },
        "justification": { "type": "string" },
        "evidence": { "type": "string" },
        "flag_for_guidelines_update": { "type": "boolean" },
        "requires_human_review": { "type": "boolean" }
      }
    },
    "trigger_reasons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "agent_requested_human_review",
          "undetermined_classification",
          "low_confidence",
          "medium_confidence",
          "guideline_update_proposed"
        ]
      }
    },
    "status": {
      "type": "string",
      "enum": ["pending", "resolved", "dismissed", "signature_mismatch"]
    },
    "feedback_id": {
      "type": ["string", "null"],
      "description": "Set in Milestone 2 once human feedback is attached (join key into the Human Feedback Schema)."
    },
    "human_feedback": {
      "type": ["object", "null"],
      "description": "The attached human feedback object (conforms to human_feedback.schema.json). Null until resolved.",
      "additionalProperties": true
    },
    "resolution_note": {
      "type": "string",
      "description": "Manager note explaining a non-resolved outcome (e.g. signature mismatch)."
    }
  }
}
