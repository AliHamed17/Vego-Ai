{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vego-ai/schemas/metric-definition-v1.schema.json",
  "title": "MetricDefinition-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "metricId",
    "title",
    "description",
    "formula",
    "unit",
    "direction",
    "grain",
    "requiredEvidenceClass",
    "nullable",
    "nullRule",
    "dimensions"
  ],
  "properties": {
    "schemaVersion": {"const": "MetricDefinition-v1"},
    "metricId": {"type": "string", "pattern": "^[A-Z][A-Z0-9_.-]+$"},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "formula": {"type": "string", "minLength": 1},
    "unit": {"type": "string", "minLength": 1},
    "direction": {
      "enum": ["higher_is_better", "lower_is_better", "target", "neutral"]
    },
    "grain": {"type": "string", "minLength": 1},
    "requiredEvidenceClass": {"type": "string", "minLength": 1},
    "nullable": {"type": "boolean"},
    "nullRule": {"type": "string", "minLength": 1},
    "dimensions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "target": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operator", "value"],
          "properties": {
            "operator": {"enum": ["eq", "lte", "gte", "between"]},
            "value": {
              "oneOf": [
                {"type": "number"},
                {
                  "type": "array",
                  "items": {"type": "number"},
                  "minItems": 2,
                  "maxItems": 2
                }
              ]
            }
          }
        }
      ]
    }
  }
}
