{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vego-ai/schemas/baseline-lock-manifest-v2.schema.json",
  "title": "BaselineLockManifest-v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "officialTag",
    "officialTagCommit",
    "requestedModel",
    "servedSnapshotKnown",
    "historicalModelLimitation",
    "pathMappings",
    "protectedTrees",
    "currentRuntimeLocks",
    "agent4Outputs",
    "claimBoundary"
  ],
  "properties": {
    "schemaVersion": {"const": "BaselineLockManifest-v2"},
    "officialTag": {"const": "official-vego-ai-baseline"},
    "officialTagCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "requestedModel": {"const": "gpt-4o"},
    "servedSnapshotKnown": {"const": false},
    "historicalModelLimitation": {"type": "string", "minLength": 1},
    "pathMappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tagPath", "currentPath"],
        "properties": {
          "tagPath": {"type": "string", "minLength": 1},
          "currentPath": {"type": "string", "minLength": 1}
        }
      }
    },
    "protectedTrees": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tagPaths",
          "currentPaths",
          "hashMode",
          "officialTagSha256",
          "currentSha256",
          "matchesOfficialTag"
        ],
        "properties": {
          "tagPaths": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "currentPaths": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "hashMode": {"const": "normalized_text_lf"},
          "officialTagSha256": {"$ref": "#/$defs/sha256"},
          "currentSha256": {"$ref": "#/$defs/sha256"},
          "matchesOfficialTag": {"const": true}
        }
      }
    },
    "currentRuntimeLocks": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sha256", "basis"],
        "properties": {
          "sha256": {"$ref": "#/$defs/sha256"},
          "basis": {"const": "pre-hardening-current-baseline"}
        }
      }
    },
    "agent4Outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controlledDataRequired", "files"],
      "properties": {
        "controlledDataRequired": {"const": true},
        "files": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "setting",
              "tagPath",
              "currentPath",
              "officialTagByteSha256",
              "canonicalJsonSha256",
              "currentLockedByteSha256",
              "matchesOfficialSemantics"
            ],
            "properties": {
              "setting": {"enum": ["cd_ch", "cd_pw", "ucd_ch", "ucd_pw"]},
              "tagPath": {"type": "string"},
              "currentPath": {"type": "string"},
              "officialTagByteSha256": {"$ref": "#/$defs/sha256"},
              "canonicalJsonSha256": {"$ref": "#/$defs/sha256"},
              "currentLockedByteSha256": {"$ref": "#/$defs/sha256"},
              "matchesOfficialSemantics": {"const": true}
            }
          }
        }
      }
    },
    "claimBoundary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
