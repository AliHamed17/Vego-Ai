{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vego-ai/schemas/architecture-run-manifest-v1.schema.json",
  "title": "ArchitectureRunManifest-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "run_id",
    "stage",
    "architecture_mode",
    "input_sha256",
    "legacy_output_sha256",
    "unified_output_sha256",
    "published_output_sha256",
    "parity_status",
    "normalization_rules",
    "baseline_preserved",
    "failure_state",
    "schema_version"
  ],
  "properties": {
    "contract": {"const": "ArchitectureRunManifest"},
    "run_id": {"type": "string", "pattern": "^HLAYER-[0-9a-f]{16}$"},
    "stage": {
      "enum": ["review", "feedback", "resolved", "memory", "advice", "comparison"]
    },
    "architecture_mode": {"enum": ["legacy", "unified", "parity"]},
    "input_sha256": {"$ref": "#/$defs/sha256"},
    "legacy_output_sha256": {"$ref": "#/$defs/sha256"},
    "unified_output_sha256": {"$ref": "#/$defs/sha256"},
    "published_output_sha256": {"$ref": "#/$defs/sha256"},
    "parity_status": {"enum": ["not_run", "match", "mismatch"]},
    "normalization_rules": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "baseline_preserved": {"const": true},
    "failure_state": {"type": ["string", "null"]},
    "schema_version": {"const": "1.0"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
