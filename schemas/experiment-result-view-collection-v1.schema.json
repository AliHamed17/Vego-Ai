{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vego-ai/schemas/experiment-result-view-collection-v1.schema.json",
  "title": "ExperimentResultViewCollection-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "publicationTier",
    "catalogSha256",
    "benchmarkSha256",
    "resultViews",
    "paperMetricMappings",
    "summary",
    "claimBoundary"
  ],
  "properties": {
    "schemaVersion": {"const": "ExperimentResultViewCollection-v1"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "publicationTier": {"enum": ["tracked_shareable", "controlled_local"]},
    "catalogSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "benchmarkSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "resultViews": {
      "type": "array",
      "minItems": 41,
      "maxItems": 41,
      "items": {"$ref": "experiment-result-view-v1.schema.json"}
    },
    "paperMetricMappings": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "paper-metric-mapping-v1.schema.json"}
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "experimentCount",
        "currentAcceptedRunCount",
        "historicalAcceptedRunCount",
        "declaredMetricCount",
        "observedMetricCount",
        "nonNullMetricCount",
        "observedNullExperimentCount",
        "classificationClaimsEligible"
      ],
      "properties": {
        "experimentCount": {"const": 41},
        "currentAcceptedRunCount": {"type": "integer", "minimum": 0},
        "historicalAcceptedRunCount": {"type": "integer", "minimum": 0},
        "declaredMetricCount": {"type": "integer", "minimum": 0},
        "observedMetricCount": {"type": "integer", "minimum": 0},
        "nonNullMetricCount": {"type": "integer", "minimum": 0},
        "observedNullExperimentCount": {"type": "integer", "minimum": 0},
        "classificationClaimsEligible": {"type": "boolean"}
      }
    },
    "claimBoundary": {"type": "string", "minLength": 1}
  }
}
