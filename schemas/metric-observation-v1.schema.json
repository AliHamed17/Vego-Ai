{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vego-ai/schemas/metric-observation-v1.schema.json",
  "title": "MetricObservation-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "metricId",
    "value",
    "numerator",
    "denominator",
    "unit",
    "direction",
    "confidenceInterval",
    "sourcePath",
    "sourceSha256",
    "evidenceClass",
    "observationDate",
    "cohortHash",
    "metricSchemaVersion",
    "claimBoundary"
  ],
  "properties": {
    "schemaVersion": {"const": "MetricObservation-v1"},
    "metricId": {"type": "string", "pattern": "^[A-Z][A-Z0-9_.-]+$"},
    "value": {"type": ["number", "integer", "string", "null"]},
    "numerator": {"type": ["number", "integer", "null"]},
    "denominator": {"type": ["number", "integer", "null"], "minimum": 0},
    "unit": {"type": "string", "minLength": 1},
    "direction": {
      "enum": ["higher_is_better", "lower_is_better", "target", "neutral"]
    },
    "confidenceInterval": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["level", "lower", "upper", "method"],
          "properties": {
            "level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
            "lower": {"type": "number"},
            "upper": {"type": "number"},
            "method": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "sourcePath": {
      "type": "string",
      "minLength": 1,
      "not": {"pattern": "^[A-Za-z]:\\\\|^file://"}
    },
    "sourceSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidenceClass": {
      "enum": [
        "historical",
        "mechanism",
        "offline",
        "synthetic",
        "evaluation_ready",
        "pilot",
        "empirical",
        "proposal",
        "blocked"
      ]
    },
    "observationDate": {"type": "string", "format": "date"},
    "cohortHash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "metricSchemaVersion": {"type": "string", "minLength": 1},
    "claimBoundary": {"type": "string", "minLength": 1}
  }
}
